#usda 1.0

def "World"
{
    def Sphere "Sphere"
    {
        double radius = 10
    }

    def "Lights"
    {
        def DiskLight "DiskLight"
        {
            float inputs:intensity = 1000
        }
    }

    def Cube "Cube" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        vector3f physics:velocity = (5, 5, 5)
    }
}

