#usda 1.0
(
    defaultPrim = "World"
)

def Xform "World"
{
    def Xform "Box"
    {
        def Scope "Geometry" (
            variants = {
                string shapes = "Cube"
            }
            prepend variantSets = "shapes"
        )
        {
            variantSet "shapes" = {
                "Cube" {
                    def Cube "Cube"
                    {
                        double3 xformOp:translate = (1, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate"]
                    }

                }
                "Sphere" {
                    def Sphere "Sphere"
                    {
                        double3 xformOp:translate = (0, 1, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate"]
                    }

                }
            }
        }
    }
}

